# === Independent AI (independentai.space) ===
# Kopyala: cp .env.example .env  (apps/web ve packages/db aynı dosyayı okur; kök .env yeterlidir)

# --- Database (Supabase Postgres, ZORUNLU) ---
# Supabase Dashboard → Project Settings → Database → Connection string
#   DATABASE_URL : Transaction pooler (6543) — uygulama runtime'ı. Prisma için `?pgbouncer=true&connection_limit=1` şart.
#   DIRECT_URL   : Session pooler (5432) — `prisma migrate deploy` bunu kullanır (DDL).
DATABASE_URL=postgresql://postgres.<ref>:<sifre>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://postgres.<ref>:<sifre>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Test veritabanı (yalnızca yerel/CI; ASLA production adresi) ---
# Entegrasyon ve E2E testleri bu adresi kullanır; supabase/neon adresleri reddedilir.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5499/independentai_test

# --- Auth (ZORUNLU) ---
# En az 32 karakter: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32-change-me-please
# Opsiyonel: API key / Slack webhook şifreleme anahtarı (yoksa JWT_SECRET türetilir).
# Rotasyon: yeni anahtarı CONFIG_ENCRYPTION_KEY'e, eskisini CONFIG_ENCRYPTION_KEY_PREVIOUS'a yaz; decrypt ikisini de dener.
CONFIG_ENCRYPTION_KEY=
CONFIG_ENCRYPTION_KEY_PREVIOUS=

# --- Vercel Cron koruması (ZORUNLU production'da, en az 16 karakter) ---
CRON_SECRET=change-me-vercel-cron-only-knows-this

# --- AI provider API keys ---
# Production'da EN AZ BİRİ zorunlu. Anahtarsız provider production'da HATA verir (sahte veri üretmez).
# Yerelde anahtar yoksa mock mod otomatik açılır; production'da mock için IAI_ALLOW_MOCK=1 gerekir (önerilmez).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Model override (allowlist: packages/ai/src/models.ts; listede olmayan ad varsayılana düşer)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
GOOGLE_MODEL=gemini-2.5-flash
# Provider native web arama/grounding (atıf verisi). 0 = kapalı (yalnızca metin içi linkler).
AI_WEB_SEARCH=1
# Sentiment/keşif sınıflandırması için tercih edilen provider (OPENAI|ANTHROPIC|GOOGLE; yoksa ilk mevcut)
AI_CLASSIFIER_PROVIDER=
# Allowlist dışı model adına izin ver (maliyet bilinmez) — yalnızca deneme için
AI_MODEL_ALLOW_UNLISTED=0
IAI_ALLOW_MOCK=0

# --- Sosyal giriş / OAuth (opsiyonel — ikisi de boşsa butonlar gizlenir) ---
# Google Cloud Console → OAuth client (Web). Yetkili yönlendirme URI'leri:
#   http://localhost:3200/api/auth/oauth/google/callback
#   https://independentai.space/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# LinkedIn Developers → "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# --- E-posta (Resend) — şifre sıfırlama, e-posta doğrulama, davet, haftalık rapor, düşüş uyarısı ---
# Yoksa gönderimler NotificationLog'a "skipped" olarak düşer; davetler linkle paylaşılır; şifre sıfırlama UI'da "kapalı" der.
RESEND_API_KEY=
EMAIL_FROM=Independent AI <bildirim@independentai.space>

# --- Lansman / plan ---
# Deneme sonrası ek süre (gün). Süre dolunca hesap salt-okunur olur (veri silinmez).
TRIAL_GRACE_DAYS=7
# Yeni kayıtların kapanacağı tarih (ISO). Boş = açık.
LAUNCH_OFFER_ENDS_AT=

# --- Demo veri (production'da kapalı) ---
IAI_ALLOW_DEMO_SEED=0

# --- Public ---
NEXT_PUBLIC_SITE_URL=https://independentai.space
