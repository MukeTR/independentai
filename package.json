{
  "name": "independentai",
  "version": "0.1.0",
  "private": true,
  "description": "Independent AI — şirketlerin ChatGPT, Claude, Gemini gibi yapay zekalarda kendi markalarının nasıl konumlandığını izlediği bağımsız görünürlük platformu (independentai.space)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @independentai/db generate && turbo run build",
    "vercel-build": "pnpm --filter @independentai/db generate && turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @independentai/db generate",
    "db:push": "pnpm --filter @independentai/db push",
    "db:migrate": "pnpm --filter @independentai/db migrate",
    "db:migrate:deploy": "pnpm --filter @independentai/db migrate:deploy",
    "db:seed": "pnpm --filter @independentai/db seed",
    "db:studio": "pnpm --filter @independentai/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,mjs}\"",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @independentai/web test:integration",
    "test:e2e": "pnpm --filter @independentai/web test:e2e"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23"
    }
  }
}
