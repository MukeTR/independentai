{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["IAI_TEST_MODE", "IAI_ALLOW_MOCK", "CI"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "TEST_DATABASE_URL",
        "DATABASE_URL",
        "DIRECT_URL",
        "JWT_SECRET",
        "CRON_SECRET",
        "IAI_TEST_MODE",
        "IAI_ALLOW_MOCK",
        "IAI_LOG_SILENT",
        "NEXT_PUBLIC_SITE_URL",
        "REALTIME_PUBLISH",
        "CI"
      ]
    }
  }
}
